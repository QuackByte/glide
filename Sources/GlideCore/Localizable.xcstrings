{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ + arrows move the cursor in text fields." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ + flechas mueve el cursor en los campos de texto."
          }
        }
      }
    },
    "%@ is a standard macOS command." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un comando estándar de macOS."
          }
        }
      }
    },
    "Add ⌃, ⌥ or ⌘ so the shortcut doesn't block normal typing." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade ⌃, ⌥ o ⌘ para que el atajo no impida escribir con normalidad."
