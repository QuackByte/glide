    },
    "Add ⌃, ⌥ or ⌘ so the shortcut doesn't block normal typing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ⌃, ⌥ oder ⌘ hinzu, damit das Tastenkürzel das normale Tippen nicht blockiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade ⌃, ⌥ o ⌘ para que el atajo no impida escribir con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez ⌃, ⌥ ou ⌘ pour que le raccourci n’empêche pas la saisie normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常の入力を妨げないよう、⌃、⌥、⌘のいずれかを加えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 때문에 일반 입력이 막히지 않도록 ⌃, ⌥ 또는 ⌘를 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione ⌃, ⌥ ou ⌘ para que o atalho não atrapalhe a digitação normal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请加上 ⌃、⌥ 或 ⌘，以免快捷键妨碍正常输入。"
          }
        }
      }
    },
