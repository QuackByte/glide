  "strings" : {
    "%@ + arrows move the cursor in text fields." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ + Pfeiltasten bewegen den Cursor in Textfeldern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ + flechas mueve el cursor en los campos de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ + flèches déplacent le curseur dans les champs de texte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@＋矢印キーは、テキストフィールドでカーソルを動かします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ + 화살표 키는 텍스트 필드에서 커서를 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ + setas movem o cursor nos campos de texto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ + 箭头键用于在文本栏中移动光标。"
          }
        }
      }
    },
